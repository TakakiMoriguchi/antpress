# ─── Phoenix ───────────────────────────────────────
# mix phx.gen.secret で生成
SECRET_KEY_BASE=
PHX_HOST=localhost

# ─── データベース（Supabase / 東京リージョン）──────────
# ⚠️ Ecto は既定で prepared statement を使うため、Supabase の
#    transaction mode プーラー（6543）を使う場合は prepare: :unnamed が必要。
#    session mode または直接接続なら不要。詳細は docs/DECISIONS.md 4.4
DATABASE_URL=

# ─── Anthropic キーの暗号鍵（cloak）──────────────────
# ⚠️ これが漏れると全 developer の Anthropic キーが復号可能になる
# 32 バイトを Base64 で: openssl rand -base64 32
CLOAK_KEY=

# ─── Supabase Storage（画像）────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=antpress

# ─── メール配信（Resend）────────────────────────────
RESEND_API_KEY=
MAIL_FROM=noreply@example.com
